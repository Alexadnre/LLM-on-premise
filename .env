# Chemins pour les documents et la sortie
BDC_PATH=static\base_de_connaissance  # Dossier contenant les documents à indexer
OUTPUT_PATH=static\output\  # Dossier pour les fichiers de sortie

# Modèles
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"  # Modèle d'embedding utilisé
CHROMA_DB_PATH=db  # Chemin pour stocker la base de données ChromaDB
COLLECTION_NAME=bdc  # Nom de la collection ChromaDB